import java.util.*;
class InvalidBookingException extends Exception {
    public InvalidBookingException(String message) {
        super(message);
    }
}
class BookingSystem {
    private Map<String, Integer> inventory = new HashMap<>();
    public BookingSystem() {
        inventory.put("Deluxe", 2);
        inventory.put("Standard", 3);
    }
    public void createBooking(String bookingId, String roomType) throws InvalidBookingException {

        if (bookingId == null || bookingId.isEmpty()) {
            throw new InvalidBookingException("Booking ID cannot be empty");
        }
        if (!inventory.containsKey(roomType)) {
            throw new InvalidBookingException("Invalid room type");
        }
        int available = inventory.get(roomType);
        if (available <= 0) {
            throw new InvalidBookingException("No rooms available");
        }
        inventory.put(roomType, available - 1);
        System.out.println("Booking successful: " + bookingId + " | " + roomType);
    }
    public void showInventory() {
        System.out.println("Inventory: " + inventory);
    }
}
public class Main {
    public static void main(String[] args) {
        BookingSystem system = new BookingSystem();
        try {
            system.createBooking("B301", "Deluxe");
            system.createBooking("B302", "Premium");
        } catch (InvalidBookingException e) {
            System.out.println("Error: " + e.getMessage());
        }
        try {
            system.createBooking("", "Standard");
        } catch (InvalidBookingException e) {
            System.out.println("Error: " + e.getMessage());
        }
        try {
            system.createBooking("B303", "Deluxe");
            system.createBooking("B304", "Deluxe");
        } catch (InvalidBookingException e) {
            System.out.println("Error: " + e.getMessage());
        }
        system.showInventory();
    }
}
